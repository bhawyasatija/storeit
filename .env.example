# Copy to .env.local and fill in the first three values from your Appwrite
# project (Settings → API Endpoint / Project ID, Overview → API Keys).
# Then run `npm run setup:appwrite` to create the database, collections and
# bucket; it fills in the remaining IDs for you.

NEXT_PUBLIC_APPWRITE_ENDPOINT="https://<region>.cloud.appwrite.io/v1"
NEXT_PUBLIC_APPWRITE_PROJECT=""

# Written by `npm run setup:appwrite` (or set them to existing resources).
NEXT_PUBLIC_APPWRITE_DATABASE=""
NEXT_PUBLIC_APPWRITE_USERS_COLLECTION=""
NEXT_PUBLIC_APPWRITE_FILES_COLLECTION=""
NEXT_PUBLIC_APPWRITE_BUCKET=""

# Server-side secret. Never commit it and never prefix it with NEXT_PUBLIC_.
NEXT_APPWRITE_KEY=""
